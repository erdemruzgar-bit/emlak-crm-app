generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}


enum ConsentType {
  ACIK_RIZA
  AYDINLATMA
  PAZARLAMA
}


enum PropertyType {
  DAIRE
  VILLA
  ARSA
  ISYERI
  MUSTAKILEV
}

enum PropertyStatus {
  ACTIVE
  SOLD
  RENTED
  INACTIVE
}

enum AppointmentType {
  GOSTERIM
  TOPLANTI
  DIGER
}

enum AppointmentStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum InteractionType {
  CALL
  EMAIL
  VISIT
  WHATSAPP
}

enum MatchStatus {
  SUGGESTED   // Sistem önerisi (otomatik)
  INTERESTED  // Danışman "ilgileniyor" olarak işaretledi
  REJECTED    // Danışman reddetti, bir daha gösterme
}

enum ContractType {
  KIRA        // Kira sözleşmesi
  SATIS       // Satış vaat sözleşmesi
  KOMISYON    // Komisyon / aracılık sözleşmesi
}

enum ContractStatus {
  DRAFT       // Taslak
  ACTIVE      // Aktif / yürürlükte
  EXPIRED     // Süresi doldu
  RENEWED     // Yenilendi (yeni kontrat oluştu)
  TERMINATED  // Feshedildi
}

enum ContractAttachmentCategory {
  KONTRAT_PDF
  KOMISYON_SOZLESMESI
  TAPU
  KIMLIK
  DEPOZITO_DEKONTU
  EK_DOKUMAN
}

enum OwnerCitizenship {
  TC
  YABANCI
  SIRKET              // Tüzel kişi / şirket sahibi (Ltd, AŞ vs.)
  VATANDASLIGA_UYGUN  // ⚠️ DEPRECATED: yeni kayıtlarda kullanılmaz; isCitizenshipEligible alanına taşınmıştır.
                      // Mevcut veri uyumluluğu için tutuluyor; UI'da artık gösterilmez.
}

enum UsageType {
  KONUT
  ISYERI
  KARMA
  ARSA_IMARLI
  ARSA_IMARSIZ
}

enum KatMulkiyetiTipi {
  KAT_MULKIYETI
  KAT_IRTIFAKI
  ARSA_PAYLI
  HISSELI
  BAGIMSIZ_BOLUMSUZ
}

enum FacingDirection {
  KUZEY
  GUNEY
  DOGU
  BATI
  KUZEY_DOGU
  KUZEY_BATI
  GUNEY_DOGU
  GUNEY_BATI
}

enum ParkingType {
  ACIK
  KAPALI
}

enum ConstructionStatus {
  INSAAT_HALINDE
  OTURUMA_HAZIR
}

enum KitchenType {
  ACIK
  KAPALI
}

enum ReminderTargetType {
  CUSTOMER
  PROPERTY
  APPOINTMENT
  CONTRACT
  GENERAL
}

enum ReminderPriority {
  LOW
  MEDIUM
  HIGH
}

// ─── Kullanıcı & Şube ───

model Branch {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]                       // Ana şubesi bu olan kullanıcılar (User.branchId)
  authorizedUsers  User[]   @relation("UserAuthorizedBranches")  // Yetkili olduğu ek şubeler (M:M)
  customers        Customer[]
  properties       Property[]
  contracts        Contract[]
  commissionPolicy CommissionPolicy?
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  photoUrl     String?
  role         Role     @default(AGENT)
  isActive     Boolean  @default(true)
  canExport    Boolean  @default(false)  // Excel dışa aktarma yetkisi (ADMIN her zaman yapabilir)
  canImport    Boolean  @default(false)  // Excel içe aktarma yetkisi
  branchId     String?  // Ana şube — kullanıcının "ait olduğu" şube (RBAC için)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch              Branch?               @relation(fields: [branchId], references: [id])
  authorizedBranches  Branch[]              @relation("UserAuthorizedBranches") // Ana şube DIŞINDA yetkili olduğu ek şubeler
  assignedCustomers   Customer[]            @relation("AssignedAgent")
  createdCustomers    Customer[]            @relation("CreatedCustomers")
  assignedProperties  Property[]            @relation("AssignedAgent")
  appointments        Appointment[]
  tasks               Task[]                @relation("TaskOwner")
  assignedTasks       Task[]                @relation("TaskAssigner")
  customerNotes       CustomerNote[]
  customerInteractions CustomerInteraction[]
  customerAccessSessions CustomerAccessSession[]
  auditLogs           AuditLog[]
  contractsCreated    Contract[]
  contractAttachmentsUploaded ContractAttachment[]
  reminders           Reminder[]
  propertyNotes       PropertyNote[]
  customerInterestedProjectsAdded CustomerInterestedProject[] @relation("CustomerInterestedProjectAddedBy")
}

// ─── KVKK Audit Log ───

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // CREATE, READ, UPDATE, DELETE
  entity    String   // Customer, Property, etc.
  entityId  String?
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  ipAddress String?
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([timestamp])
}

// ─── Müşteri Yönetimi ───

model Customer {
  id             String       @id @default(cuid())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  altPhone       String?      // İkincil telefon (örn. Excel'de "Diğer: ...")
  tcKimlikNo     String?      // AES-256 encrypted
  address        String?
  customerType   String       @default("BUYER") // CustomerTypeCatalog.code referansı
  source         String?      // Referans, İnternet, vs.
  photoUrl       String?
  isAnonymized   Boolean      @default(false)
  assignedAgentId String?
  createdById    String?      // Müşteriyi sisteme ekleyen kullanıcı (KVKK: kendi eklediğini açık görür)
  branchId       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // === TALEP PROFİLİ ===
  stage              String?   // LEAD, QUALIFIED, ACTIVE, SHOWING, OFFER, CONTRACT, CLOSED, LOST
  minBudget          Float?
  maxBudget          Float?
  budgetCurrency     String?   @default("TRY")

  // === ZAMAN / ACİLİYET ===
  urgency            String?   // LOW, MEDIUM, HIGH, URGENT
  desiredMoveDate    DateTime?

  // === MÜLK TERCİHLERİ ===
  preferredTypes     String[]  // ["DAIRE", "VILLA"]
  preferredCities    String[]  // ["İstanbul"]
  preferredDistricts String[]  // ["Kadıköy", "Beşiktaş"]
  minArea            Float?
  maxArea            Float?
  minRooms           String?   // "2+1"
  maxRooms           String?   // "4+1"
  preferredFeatures  String[]  // ["Otopark", "Havuz", "Asansör"]

  // === FİNANSMAN ===
  financingMethod    String?   // NAKIT, KREDI, TAKAS
  preApprovalStatus  String?   // NONE, PENDING, APPROVED, REJECTED
  downPaymentPercent Float?

  // === SEGMENTASYON ===
  tags               String[]  // ["VIP", "Yatırımcı"]
  notesSummary       String?   @db.Text

  // === TAKİP ===
  lastContactDate    DateTime?
  nextFollowUpDate   DateTime?

  assignedAgent  User?               @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  createdBy      User?               @relation("CreatedCustomers", fields: [createdById], references: [id])
  branch         Branch?             @relation(fields: [branchId], references: [id])
  consents       CustomerConsent[]
  notes          CustomerNote[]
  accessSessions CustomerAccessSession[]
  interactions   CustomerInteraction[]
  propertyMatches PropertyMatch[]
  ownedProperties Property[]          @relation("PropertyOwner")
  appointments   Appointment[]
  contracts      Contract[]          @relation("ContractCustomer")
  ownedContracts Contract[]          @relation("ContractOwner")
  interestedProjects CustomerInterestedProject[]

  @@index([assignedAgentId])
  @@index([createdById])
  @@index([branchId])
  @@index([stage])
  @@index([urgency])
  @@index([lastContactDate])
  @@index([nextFollowUpDate])
}

// Müşteri ↔ Proje çoklu ilişki (explicit join — ileride note/addedBy gibi alan taşımak için)
model CustomerInterestedProject {
  id         String   @id @default(cuid())
  customerId String
  projectId  String
  addedById  String?
  note       String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  addedBy  User?    @relation("CustomerInterestedProjectAddedBy", fields: [addedById], references: [id])

  @@unique([customerId, projectId])
  @@index([customerId])
  @@index([projectId])
}

model CustomerConsent {
  id          String      @id @default(cuid())
  customerId  String
  consentType ConsentType
  consentText String      @db.Text
  isGranted   Boolean     @default(false)
  grantedAt   DateTime?
  revokedAt   DateTime?
  ipAddress   String?
  createdAt   DateTime    @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  userId     String
  content    String   @db.Text
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  accessSessionExits CustomerAccessSession[] @relation("ExitNote")
}

// ─── KVKK: Hassas Veri Erişim Oturumu ───
// AGENT rolü hassas alanları (telefon, email, TC) görmek için bir oturum açar:
// 1) Giriş gerekçesi + kategori verir       → session row created
// 2) Sayfadan ayrılırken sonuç notu zorunlu  → CustomerNote oluşur, session.exitNoteId & endedAt set edilir
// Not yazılmadan tab kapatılırsa ABANDONED, aksi halde COMPLETED olarak işaretlenir.
model CustomerAccessSession {
  id              String    @id @default(cuid())
  customerId      String
  userId          String
  reasonCategory  String    // GORUSME, TAKIP, TEKLIF, SOZLESME, DIGER
  reason          String    @db.Text
  fields          String[]  // İlk açılışta hangi alan istendi: ["phone"], ["email"], ["tc"]
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  exitNoteId      String?
  status          String    @default("ACTIVE") // ACTIVE, COMPLETED, ABANDONED
  ipAddress       String?
  userAgent       String?

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id])
  exitNote CustomerNote?  @relation("ExitNote", fields: [exitNoteId], references: [id])

  @@index([customerId])
  @@index([userId])
  @@index([startedAt])
  @@index([status])
}

model CustomerInteraction {
  id         String          @id @default(cuid())
  customerId String
  userId     String
  type       InteractionType
  summary    String?         @db.Text
  date       DateTime        @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
}

// ─── İlan / Portföy ───

model Property {
  id             String         @id @default(cuid())
  title          String
  listingType    String        // ListingTypeCatalog.code referansı
  propertyType   PropertyType
  price          Float
  currency       String         @default("TRY")
  area           Float?         // m²
  rooms          String?        // 3+1, 2+1, vs.
  bathrooms      Int?
  floor          Int?
  totalFloors    Int?
  age            Int?           // Bina yaşı
  heating        String?
  address        String?
  city           String?
  district       String?
  neighborhood   String?
  lat            Float?
  lng            Float?
  description    String?        @db.Text
  status         PropertyStatus @default(ACTIVE)
  ownerId        String?
  assignedAgentId String?
  branchId       String?

  // ─── Proje / Blok hiyerarşisi (opsiyonel, toplu konut projeleri için) ───
  projectId      String?
  blockId        String?
  unitNumber     String?         // Daire no (örn: "026", "D/01-071")

  // ─── Tapu bilgileri (Türkiye-spesifik) ───
  ada               String?
  pafta             String?
  parsel            String?
  bagimsizBolumNo   String?
  katMulkiyetiTipi  KatMulkiyetiTipi?

  // ─── Sakin, vatandaşlık, kullanım ───
  occupancyStatus       String?            // OccupancyStatusCatalog.code referansı
  ownerCitizenship      OwnerCitizenship?
  // Yabancıya satışta TR vatandaşlık programı için uygun mülk (sahibinin uyruğundan bağımsız mülk özelliği).
  isCitizenshipEligible Boolean?
  // Vatandaşlığa uygun fiyatı için satış fiyatına eklenen fark (aynı para biriminde).
  // Görüntülemede: vatandaşlık fiyatı = price + citizenshipPriceDiff
  citizenshipPriceDiff  Float?
  usageType             UsageType?

  // ─── Ek özellikler ───
  hasElevator       Boolean?
  hasParking        Boolean?
  parkingType       ParkingType?
  parkingSpotCount  Int?             // sadece kapalı otoparkta anlamlı — B. Bölüme düşen otopark sayısı
  hasBalcony        Boolean?
  facingDirection   FacingDirection?

  // İnşaat durumu + tapu
  constructionStatus ConstructionStatus?  // Oturuma hazır / İnşaat halinde (age=0 durumu için)
  hasTitleDeed       Boolean?             // Tapu kaydı var/yok

  // Mutfak tipi
  kitchenType        KitchenType?         // Açık / Kapalı

  // ─── Manzara / operasyonel ───
  viewType          String?               // Proje-spesifik manzara kodu (örn. "PEYZAJ", "ARMONI", "3 CPH")
  operationalNote   String?  @db.Text     // Liste'de kısa not (Excel "DURUM" kolonundan map dışı kalan kısım)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  owner         Customer?       @relation("PropertyOwner", fields: [ownerId], references: [id])
  assignedAgent User?           @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  branch        Branch?         @relation(fields: [branchId], references: [id])
  project       Project?        @relation(fields: [projectId], references: [id])
  block         Block?          @relation(fields: [blockId], references: [id])
  images        PropertyImage[]
  matches       PropertyMatch[]
  appointments  Appointment[]
  contracts     Contract[]
  notes         PropertyNote[]

  @@index([status])
  @@index([listingType])
  @@index([city, district])
  @@index([assignedAgentId])
  @@index([projectId])
  @@index([blockId])
  @@index([occupancyStatus])
}

// ─── Toplu Konut Projesi / Blok ───

model Project {
  id          String   @id @default(cuid())
  name        String
  code        String?  @unique  // Kullanıcı tarafından atanan kısa kod (ör. "2124") — toplu yapıştırma akışı için
  city        String?
  district    String?
  address     String?
  developer   String?  // Müteahhit
  description String?  @db.Text
  // Bu projeye özel manzara/yön kodları (autocomplete listesi). Boş array = serbest giriş.
  viewTypes   String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  blocks     Block[]
  properties Property[]
  interestedCustomers CustomerInterestedProject[]

  @@index([name])
  @@index([city, district])
}

model Block {
  id         String   @id @default(cuid())
  projectId  String
  name       String   // "A", "B-1", "D/02"
  totalUnits Int?
  createdAt  DateTime @default(now())

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  properties Property[]

  @@unique([projectId, name])
  @@index([projectId])
}

// ─── Mülke bağlı görüşme/durum notu ───
// Property'nin günlük operasyon defteri: telefon görüşmeleri, toplantı notları,
// "DURUM" kolonundan map dışı kalan kısa metinler ve Excel ile içeri aktarılan
// görüşme geçmişi burada tutulur. Customer'a değil, Property'ye bağlanır —
// proje-merkezli kullanıcı bir daire bazında geçmişi görmek ister.
enum PropertyNoteKind {
  GENERAL
  CALL_LOG
  MEETING
  OPERATIONAL_STATUS
  IMPORTED
}

model PropertyNote {
  id            String           @id @default(cuid())
  propertyId    String
  userId        String           // Notu yazan / import yapan kullanıcı
  kind          PropertyNoteKind @default(GENERAL)
  content       String           @db.Text
  source        String?          // null | "form" | "excel-import" | "auto"
  importBatchId String?          // Aynı import işleminin grup id'si
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([propertyId, createdAt])
  @@index([kind])
  @@index([importBatchId])
}

// ─── Oda Tipi Kataloğu ───
// Property.rooms alanı String olarak kalır (eski veri korunur). Bu tablo sadece
// dropdown için seçim listesi — ADMIN/MANAGER yeni tip ekleyip silebilir.

model RoomType {
  id        String   @id @default(cuid())
  name      String   @unique  // "1+1", "3+1", "Dubleks" vb.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

model CustomerTypeCatalog {
  id           String   @id @default(cuid())
  code         String   @unique  // "BUYER", "SELLER", "TENANT", "TENANT_CANDIDATE", "LANDLORD", custom
  label        String             // Türkçe görünen ad
  isTenantSide Boolean  @default(false)  // Kira/Satış kontratında "Kiracı/Alıcı" filtresinde görünsün mü
  isOwnerSide  Boolean  @default(false)  // Kontratında "Mülk Sahibi" filtresinde görünsün mü
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sortOrder])
}

model ListingTypeCatalog {
  id        String   @id @default(cuid())
  code      String   @unique  // "SATILIK", "KIRALIK", "ARSIV", custom
  label     String             // Türkçe görünen ad
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// ─── Sakin Durumu Kataloğu ───
// Property.occupancyStatus alanı String olarak kalır (eski veri korunur). Bu tablo
// dropdown için seçim listesi — ADMIN/MANAGER yeni durum ekleyip silebilir.
model OccupancyStatusCatalog {
  id        String   @id @default(cuid())
  code      String   @unique  // "SAHIBI_OTURUYOR", "KAPORA_ALINDI", custom
  label     String             // Türkçe görünen ad
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model PropertyImage {
  id         String  @id @default(cuid())
  propertyId String
  url        String
  order      Int     @default(0)
  isPrimary  Boolean @default(false)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PropertyMatch {
  id         String      @id @default(cuid())
  propertyId String
  customerId String
  matchScore Float?
  status     MatchStatus @default(SUGGESTED)
  isNotified Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @default(now()) @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([propertyId, customerId])
  @@index([status])
}

// ─── Randevu & Görev ───

model Appointment {
  id         String            @id @default(cuid())
  title      String
  type       AppointmentType   @default(GOSTERIM)
  propertyId String?
  customerId String?
  userId     String
  startDate  DateTime
  endDate    DateTime
  location   String?
  notes      String?           @db.Text
  status     AppointmentStatus @default(PLANNED)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  property Property? @relation(fields: [propertyId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  user     User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([startDate])
}

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?      @db.Text
  userId       String
  assignedById String?
  dueDate      DateTime?
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(TODO)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user       User  @relation("TaskOwner", fields: [userId], references: [id])
  assignedBy User? @relation("TaskAssigner", fields: [assignedById], references: [id])

  @@index([userId])
  @@index([status])
}

// ─── Sözleşme Yönetimi ───

model Contract {
  id              String          @id @default(cuid())
  contractType    ContractType
  propertyId      String?
  customerId      String?         // kiracı / alıcı
  ownerCustomerId String?         // mülk sahibi (opsiyonel)
  title           String          // kısa başlık
  startDate       DateTime
  endDate         DateTime?       // kira için zorunlu; satışta null olabilir
  amount          Float           // kira tutarı / satış bedeli / hizmet bedeli
  currency        String          @default("TRY")
  depositAmount   Float?          // kira depozitosu
  commissionRate  Float?          // % komisyon oranı
  commissionAmount Float?         // hesaplanmış komisyon tutarı
  commissionSplit String?         @db.Text // JSON: { agentId: 50, partnerAgencyId: 50 }
  status          ContractStatus  @default(DRAFT)
  signedAt        DateTime?
  notes           String?         @db.Text
  createdById     String
  branchId        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  property    Property?            @relation(fields: [propertyId], references: [id])
  customer    Customer?            @relation("ContractCustomer", fields: [customerId], references: [id])
  ownerCustomer Customer?          @relation("ContractOwner", fields: [ownerCustomerId], references: [id])
  createdBy   User                 @relation(fields: [createdById], references: [id])
  branch      Branch?              @relation(fields: [branchId], references: [id])
  attachments ContractAttachment[]

  @@index([propertyId])
  @@index([customerId])
  @@index([status])
  @@index([endDate])
  @@index([contractType])
}

model ContractAttachment {
  id         String                       @id @default(cuid())
  contractId String
  fileName   String
  fileUrl    String
  fileSize   Int
  mimeType   String
  category   ContractAttachmentCategory   @default(EK_DOKUMAN)
  uploadedById String
  uploadedAt DateTime                     @default(now())

  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@index([contractId])
}

// ─── Hatırlatmalar ───

model Reminder {
  id          String             @id @default(cuid())
  userId      String             // Sahibi (kime ait)
  title       String
  description String?            @db.Text
  dueDate     DateTime
  priority    ReminderPriority   @default(MEDIUM)
  isDone      Boolean            @default(false)
  doneAt      DateTime?
  targetType  ReminderTargetType @default(GENERAL)
  targetId    String?            // Customer/Property/Appointment/Contract ID'si (GENERAL için null)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDone])
  @@index([dueDate])
  @@index([targetType, targetId])
}

// ─── Komisyon Politikası ───
// branchId NULL ise = şirket geneli (default).
// branchId doluysa = o şubenin override'ı.
// Her şube için en fazla bir politika kaydı tutulur (@@unique([branchId])).
//
// payoutTemplate: hesaplayıcıda hangi default şablon seçili gelir
//   - CLASSIC: tek ofis, tek danışman; bizim ofis = %100, danışman ofise düşenden alır
//   - COBROKER: iki ofis (bizim + partner) %50/%50
//   - DOUBLE_AGENT: aynı ofis, iki danışman (alıcı + satıcı tarafı)
//   - COBROKER_DOUBLE: iki ofis + her iki tarafın da farklı danışmanları

model CommissionPolicy {
  id        String   @id @default(cuid())
  branchId  String?  @unique  // null = şirket geneli
  name      String   @default("Varsayılan")

  // Satış varsayılan oranları (yüzde)
  salesBuyerRate    Float    @default(2)
  salesSellerRate   Float    @default(2)

  // Kira varsayılan oranları (yüzde — kira tutarına oranla)
  rentTenantRate    Float    @default(100)   // 1 aylık kira = %100
  rentLandlordRate  Float    @default(0)

  // KDV
  vatRate            Float   @default(20)
  vatIncludedDefault Boolean @default(true)

  // Co-broker payı (partner ofis varsa) — bizim ofise düşen %
  cobrokerOwnShare       Float @default(50)

  // Bizim ofis payından danışmana giden % (tek danışman senaryosu)
  agentShareOfOwnOffice  Float @default(50)

  // Çift danışman varsa danışman havuzunda alıcı tarafı %
  // (sellerSide = 100 - bu)
  buyerSideAgentShare    Float @default(50)

  // Default şablon
  payoutTemplate    String   @default("CLASSIC") // CLASSIC | COBROKER | DOUBLE_AGENT | COBROKER_DOUBLE

  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
